# ─── Database ────────────────────────────────────────────────
# Matches docker-compose.yml (host port 33061). Change if you use your own MariaDB/MySQL.
DATABASE_URL="mysql://dhaka:dhaka_local_dev@127.0.0.1:33061/dhaka_resident"
# Used only by `npm run test:integration` (created automatically by the Docker init script).
TEST_DATABASE_URL="mysql://dhaka:dhaka_local_dev@127.0.0.1:33061/dhaka_resident_test"
# Connection pool size (default 5). Shared hosting caps max_user_connections, often at 20.
DB_CONNECTION_LIMIT="5"

# ─── App ─────────────────────────────────────────────────────
# Public base URL, used in emails, sitemap and canonical links.
APP_URL="http://localhost:3000"

# ─── Email (optional) ────────────────────────────────────────
# Leave SMTP_HOST empty to disable email. The app then shows notifications in-app only
# and clearly tells users and admins that emails are not being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Dhaka Resident <no-reply@example.com>"

# ─── SMS for one-time codes (optional) ───────────────────────
# Without a provider, the development server prints sign-up/login codes in the terminal,
# and in production SMS codes are unavailable (email codes still work if SMTP is set).
# Supported: twilio. Other gateways can be added in src/server/services/sms.ts.
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ─── Uploads ─────────────────────────────────────────────────
# Directory (relative to the project root) where uploaded listing photos are stored.
UPLOAD_DIR="storage/uploads"
